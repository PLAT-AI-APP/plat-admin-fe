# 목업 구간의 관리자 API 베이스 URI.
# 실서버와 **오리진이 달라야** MSW가 실서버 요청을 가로채지 않는다.
# 이 포트에는 아무것도 떠 있지 않다 — 목업 핸들러가 전부 응답한다.
NEXT_PUBLIC_BASE_URI=http://localhost:9090

# MSW 목업 사용 여부 ("enabled" 일 때만 활성화)
NEXT_PUBLIC_API_MOCKING=enabled

# 실서버(plat-be) 베이스 URI. 연동이 끝난 도메인만 여기로 나간다.
# 관리자 API(/admin/**)는 plat-boot 이 서비스 API 와 같은 포트에서 함께 서빙한다.
NEXT_PUBLIC_LIVE_BASE_URI=http://localhost:8080

# 이미지 서버 베이스 URI.
# 이미지는 관리자 API가 아니라 서비스 서버가 인증 없이 서빙한다(GET /images/{fileId}).
# 관리자 서버가 URL을 만들어 주지 못하므로 어드민이 fileId로 직접 조립한다.
# 비워 두면 이미지 자리에 자리표시가 그려진다.
NEXT_PUBLIC_IMAGE_BASE_URI=http://localhost:8080
